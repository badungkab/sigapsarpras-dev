const CONFIG = { API_KEY: 'sarpras2026', SESSION_SECONDS: 21600, PHOTO_FOLDER: 'SIGAP_SARPRAS_FOTO' };
const HEADERS = {
  Users: ['id','username','password','nama_lengkap','role','status','sekolah_id','created_at'],
  Sekolah: ['id','nama_sekolah','kecamatan','alamat','lat','lng','created_at'],
  Sarpras: ['id','sekolah_id','nama_sekolah','nama_barang','kategori','jumlah','kondisi','created_at'],
  LaporanKerusakan: ['id','sekolah_id','nama_sekolah','nama_barang','kategori','tingkat','deskripsi','foto','tanggal','pelapor','no_hp','email','status','petugas','tanggal_perbaikan','biaya','created_at','status_validasi','catatan_validasi','dibuat_oleh','divalidasi_oleh','divalidasi_pada','dikembalikan_oleh','dikembalikan_pada','diterima_oleh','diterima_pada','dihapus_oleh','dihapus_pada'],
