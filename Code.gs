const VALID_ROLES = ['admin','operator','kepsek','pimpinan'];
function roleKey_(v){const x=String(v||'').trim().toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ');if(['admin','administrator','administrator dinas'].includes(x))return 'admin';if(['operator','operator sekolah','operator sekolah sd'].includes(x))return 'operator';if(['kepsek','kepala sekolah','kepala sekolah sd'].includes(x))return 'kepsek';if(['pimpinan','pimpinan dinas'].includes(x))return 'pimpinan';return x;}
function statusKey_(v){return String(v==null?'':v).trim().toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ');}
function isActive_(v){return ['aktif','active','1','true'].includes(statusKey_(v));}
function isDraftStatus_(v){return ['draft','belum','menunggu kepala sekolah','menunggu validasi','pending'].includes(statusKey_(v));}
function isReturnedStatus_(v){return ['dikembalikan','perlu perbaikan','returned'].includes(statusKey_(v));}

function json_(o){ return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function ss_(){ return SpreadsheetApp.getActiveSpreadsheet(); }
function sh_(name){ let s=ss_().getSheetByName(name); if(!s) s=ss_().insertSheet(name); return s; }
function sha256_(v){ const b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v||''),Utilities.Charset.UTF_8); return b.map(x=>('0'+((x+256)%256).toString(16)).slice(-2)).join(''); }
function isHash_(v){ return /^[a-f0-9]{64}$/i.test(String(v||'')); }
function now_(){ return new Date().toISOString(); }
function read_(name){ const s=sh_(name), values=s.getDataRange().getValues(); if(values.length<2)return []; const heads=values[0].map(String); return values.slice(1).filter(r=>r.some(v=>v!==''&&v!==null)).map(r=>{const o={};heads.forEach((h,i)=>o[h]=r[i]===undefined?'':r[i]);return o;}); }
function headers_(name){ const s=sh_(name); if(s.getLastRow()===0){s.getRange(1,1,1,HEADERS[name].length).setValues([HEADERS[name]]);s.setFrozenRows(1);return;} const last=Math.max(1,s.getLastColumn()), old=s.getRange(1,1,1,last).getValues()[0].map(String); const add=HEADERS[name].filter(h=>!old.includes(h)); if(add.length)s.getRange(1,last+1,1,add.length).setValues([add]); s.setFrozenRows(1); }
function rowObject_(name,row){const s=sh_(name),heads=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String),o={};heads.forEach((h,i)=>o[h]=row[i]===undefined?'':row[i]);return o;}
function append_(name,obj){const s=sh_(name),heads=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String);s.appendRow(heads.map(h=>obj[h]===undefined?'':obj[h]));}
function updateRow_(name,rowNum,obj){const s=sh_(name),heads=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String),old=s.getRange(rowNum,1,1,heads.length).getValues()[0];heads.forEach((h,i)=>{if(Object.prototype.hasOwnProperty.call(obj,h))old[i]=obj[h];});s.getRange(rowNum,1,1,heads.length).setValues([old]);}
function findRow_(name,id){const s=sh_(name),v=s.getDataRange().getValues();if(v.length<2)return -1;const h=v[0].map(String),c=h.indexOf('id');if(c<0)return -1;for(let i=1;i<v.length;i++)if(String(v[i][c])===String(id))return i+1;return -1;}
function nextId_(name,prefix){const rows=read_(name);let n=0;rows.forEach(x=>{const m=String(x.id||'').match(new RegExp('^'+prefix+'(\\d+)$'));if(m)n=Math.max(n,Number(m[1]));});return prefix+String(n+1).padStart(5,'0');}
function log_(actor,aksi,objek,keterangan){append_('LogAktivitas',{id:Utilities.getUuid(),waktu:now_(),user_id:actor?actor.id:'SYSTEM',nama_user:actor?actor.nama:'SYSTEM',role:actor?actor.role:'system',aksi:aksi,objek_id:objek||'',keterangan:keterangan||''});}
function session_(token){if(!token)return null;const raw=CacheService.getScriptCache().get('SIGAP_'+token);if(!raw)return null;try{const s=JSON.parse(raw);const u=read_('Users').find(x=>String(x.id)===String(s.id)&&isActive_(x.status));if(!u)return null;return {id:u.id,username:u.username,nama:u.nama_lengkap,role:roleKey_(u.role),sekolah_id:u.sekolah_id||''};}catch(e){return null;}}
function actor_(b){return session_(b&&b.session_token);}
function need_(b,roles){const a=actor_(b);return a&&roles.indexOf(a.role)>=0?a:null;}
function savePhoto_(data,name){if(!data)return '';const raw=String(data).replace(/^data:image\/[a-zA-Z0-9.+-]+;base64,/,'');if(raw.length>8*1024*1024)throw new Error('Foto terlalu besar. Maksimal sekitar 6 MB.');let it=DriveApp.getFoldersByName(CONFIG.PHOTO_FOLDER),folder=it.hasNext()?it.next():DriveApp.createFolder(CONFIG.PHOTO_FOLDER);const blob=Utilities.newBlob(Utilities.base64Decode(raw),'image/jpeg',(name||('foto_'+Date.now()+'.jpg')).replace(/[^a-zA-Z0-9._-]/g,'_'));const f=folder.createFile(blob);f.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return 'https://drive.google.com/file/d/'+f.getId()+'/view';}
function setupDatabase(){Object.keys(HEADERS).forEach(headers_);const users=read_('Users');if(!users.length){append_('Users',{id:1,username:'admin',password:sha256_('admin123'),nama_lengkap:'Administrator',role:'admin',status:'aktif',sekolah_id:'',created_at:now_()});}Logger.log('Setup selesai. Sheet tersedia: '+Object.keys(HEADERS).join(', '));}
function migrateData(){Object.keys(HEADERS).forEach(headers_);const s=sh_('LaporanKerusakan'),v=s.getDataRange().getValues(),heads=v[0].map(String),idx=heads.indexOf('status');let changed=0;for(let i=1;i<v.length;i++){if(!v[i].some(x=>x!==''&&x!==null))continue;const st=idx>=0?String(v[i][idx]||''):'';if(!st||st==='Belum'){if(idx>=0)s.getRange(i+1,idx+1).setValue('Draft');changed++;}const sv=heads.indexOf('status_validasi');if(sv>=0&&!v[i][sv])s.getRange(i+1,sv+1).setValue('Menunggu Kepala Sekolah');}Logger.log('Migrasi selesai. Baris status awal yang disesuaikan: '+changed);}
function doGet(e){const p=e&&e.parameter||{};if(p.key!==CONFIG.API_KEY)return json_({ok:false,msg:'Kunci API tidak valid.'});const a=session_(p.session_token);if(p.action==='health'){return json_({ok:true,version:'2026.11.20.2',sheets:Object.keys(HEADERS)});}if(p.action==='publicStats'){const ls=read_('LaporanKerusakan');return json_({ok:true,sekolah:read_('Sekolah').length,sarpras:read_('Sarpras').length,laporan:ls.length,selesai:ls.filter(x=>String(x.status)==='Selesai').length});}if(p.action==='getData'){if(!a)return json_({ok:false,msg:'Silakan login kembali.'});let sekolah=read_('Sekolah'),sarpras=read_('Sarpras'),laporan=read_('LaporanKerusakan');if(['operator','kepsek'].includes(a.role)){if(!a.sekolah_id)return json_({ok:false,msg:'Akun belum ditautkan ke sekolah. Hubungi Administrator.'});sekolah=sekolah.filter(x=>String(x.id)===String(a.sekolah_id));sarpras=sarpras.filter(x=>String(x.sekolah_id)===String(a.sekolah_id));laporan=laporan.filter(x=>String(x.sekolah_id)===String(a.sekolah_id));}return json_({ok:true,sekolah,sarpras,laporan});}if(p.action==='getUsers'){if(!a||a.role!=='admin')return json_({ok:false,msg:'Akses hanya untuk Administrator.'});return json_({ok:true,users:read_('Users').map(({password,...u})=>u)});}if(p.action==='getLogs'){if(!a||a.role!=='admin')return json_({ok:false,msg:'Akses hanya untuk Administrator.'});return json_({ok:true,logs:read_('LogAktivitas').slice(-500).reverse()});}return json_({ok:false,msg:'Aksi GET tidak dikenal.'});}
function doPost(e){let b;try{b=JSON.parse((e&&e.postData&&e.postData.contents)||'{}');}catch(err){return json_({ok:false,msg:'Format permintaan tidak valid.'});}if(b.key!==CONFIG.API_KEY)return json_({ok:false,msg:'Kunci API tidak valid.'});try{return route_(b);}catch(err){return json_({ok:false,msg:'Terjadi kesalahan server: '+err.message});}}
